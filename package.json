{
  "name": "coral-reef-wallpaper",
  "version": "0.1.0",
  "description": "인터랙티브 산호초를 Windows와 macOS 바탕화면으로 사용하는 라이브 월페이퍼",
  "author": "Soobin Park",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "desktop:build": "vite build --config desktop/vite.config.ts && node desktop/copy-assets.mjs",
    "desktop:typecheck": "tsc --project desktop/tsconfig.json --noEmit",
    "desktop:run": "npm run desktop:build && electron desktop/electron/main.cjs",
    "desktop:dist": "npm run desktop:build && electron-builder --config desktop/electron-builder.json",
    "desktop:dist:mac": "npm run desktop:build && electron-builder --config desktop/electron-builder.json --mac",
    "desktop:dist:mac:notarized": "node desktop/build-notarized.mjs",
    "desktop:dist:win": "npm run desktop:build && electron-builder --config desktop/electron-builder.json --win",
    "test:auth": "vitest run",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "drizzle-orm": "0.45.2",
    "firebase": "^12.19.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "44.9.3",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.37.5",
    "globals": "16.4.0",
    "jsdom": "^30.1.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "^5.0.2",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "main": "desktop/electron/main.cjs",
  "allowScripts": {
    "electron@44.9.3": true
  }
}
